{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchtower-telegram",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "watchtower.rittmang.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupModerator"] },
    { "tag": "v2", "new_sqlite_classes": ["PlanetScaleModerator"] },
    { "tag": "v3", "deleted_classes": ["GroupModerator", "PlanetScaleModerator"] },
  ],
  "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "DEV_MODE": "false",
    "DATABASE_BACKEND": "planetscale",
    "TELEGRAM_CHAT_ID": "-1001255868451",
    "TELEGRAM_BOT_USERNAME": "naaradmunibot",
    "WORKER_URL": "https://watchtower-telegram.godmod.workers.dev",
    "OWNER_TELEGRAM_ID": "869529747",
    "ADMIN_EMAIL": "rightonrittman@gmail.com",
    "ACCESS_TEAM_DOMAIN": "https://rightonrittman.cloudflareaccess.com",
    "ACCESS_AUD": "5daf5d7279fd9eb69528cf8f52053bc34df13c46b19cad02a4c8fdbb39fbe656",
  },
}
